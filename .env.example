# ==============================================================================
# SimpStock - Configuração de Variáveis de Ambiente (Cloud Run & Supabase)
# ==============================================================================

# Configurações do Servidor
FLASK_ENV=production
FLASK_DEBUG=False
PORT=8080

# Chaves Criptográficas (OBRIGATÓRIO: altere para hashes seguros e aleatórios em produção)
SECRET_KEY=sua-chave-secreta-de-sessao-longa-e-aleatoria
JWT_SECRET=sua-chave-jwt-super-secreta-longa-e-aleatoria
JWT_EXPIRATION_HOURS=24

# Banco de Dados (Exclusivo via DATABASE_URL)
# Conexão com Supabase PostgreSQL via Connection Pooling (Supavisor) na porta 6543 com SSL obrigatório:
# Formato padrão:
# postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@[POOLER_HOST]:6543/postgres?sslmode=require
# Exemplo para o projeto Supabase (cxxknecvqvmyrveralmx na região sa-east-1 / São Paulo):
DATABASE_URL=postgresql://postgres.cxxknecvqvmyrveralmx:SUA_SENHA_DO_BANCO_AQUI@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Administrador Padrão da Plataforma (Criado na inicialização se inexistente)
ADMIN_NAME=ADM
ADMIN_EMAIL=admin@simpstock.com
ADMIN_DEFAULT_PASSWORD=admin123

# Controle de Origens CORS (Defina as URLs dos frontends em produção, ex: https://seu-app.web.app)
CORS_ORIGINS=*
