# Configurações do Servidor
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000

# Chaves Criptográficas (Troque em produção!)
SECRET_KEY=simpstock-dev-secret-key-change-in-production
JWT_SECRET=simpstock-jwt-super-secret-key-change-in-production
JWT_EXPIRATION_HOURS=24

# Administrador Padrão
ADMIN_NAME=ADM
ADMIN_EMAIL=admin@simpstock.com
ADMIN_DEFAULT_PASSWORD=admin123

# Banco de Dados
DATABASE_PATH=banco.db

# CORS
CORS_ORIGINS=*
